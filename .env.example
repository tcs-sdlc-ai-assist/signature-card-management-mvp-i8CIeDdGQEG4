# SIG Card Management - Environment Variables
# Copy this file to .env and update values as needed.

# Session timeout in minutes (how long before an idle session expires)
VITE_SESSION_TIMEOUT_MINUTES=15

# Session warning in minutes (how long before timeout to show warning)
VITE_SESSION_WARNING_MINUTES=2

# Maximum number of failed login attempts before account lockout
VITE_MAX_LOGIN_ATTEMPTS=5

# OTP expiry time in seconds
VITE_OTP_EXPIRY_SECONDS=300

# Maximum number of OTP verification attempts
VITE_OTP_MAX_ATTEMPTS=3

# Cooldown period in seconds before OTP can be resent
VITE_OTP_RESEND_COOLDOWN_SECONDS=60

# Authentication token expiry in hours
VITE_TOKEN_EXPIRY_HOURS=8

# Maximum number of card unlock requests allowed per day
VITE_UNLOCK_MAX_DAILY=3

# Maximum number of OTP resend requests allowed per day
VITE_RESEND_MAX_DAILY=5